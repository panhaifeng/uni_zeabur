{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^disclaimer$": "@/components/disclaimer.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "单词打地鼠",
				"navigationBarBackgroundColor": "#2e7d32",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationBarBackgroundColor": "#2e7d32",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/select/select",
			"style": {
				"navigationBarTitleText": "选择词库",
				"navigationBarBackgroundColor": "#2e7d32",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/game/game",
			"style": {
				"navigationBarTitleText": "挑战中",
				"navigationBarBackgroundColor": "#1b5e20",
				"navigationBarTextStyle": "white",
				"disableScroll": true
			}
		},
		{
			"path": "pages/result/result",
			"style": {
				"navigationBarTitleText": "本局结果",
				"navigationBarBackgroundColor": "#2e7d32",
				"navigationBarTextStyle": "white"
			}
		}
	],
	"globalStyle": {
		"navigationBarBackgroundColor": "#2e7d32",
		"navigationBarTitleText": "单词打地鼠",
		"navigationBarTextStyle": "white",
		"backgroundColor": "#f3faf4"
	},
	"tabBar": {
		"color": "#8a8a8a",
		"selectedColor": "#2e7d32",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/tabbar/shouye.png",
				"selectedIconPath": "static/tabbar/shouye_cur.png"
			},
			{
				"pagePath": "pages/mine/mine",
				"text": "我的",
				"iconPath": "static/tabbar/user.png",
				"selectedIconPath": "static/tabbar/user_cur.png"
			}
		]
